{
  "name": "dash-eval-bench",
  "productName": "DASH",
  "version": "0.1.0",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.ui.json && node dist/scripts/assets.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.ui.json",
    "start": "npm run build && electron .",
    "test": "npm run build:test && node --test dist/test/*.test.cjs",
    "test:desktop": "npm run build:test && electron dist/test/desktop-smoke.cjs",
    "test:workflow": "npm run build:test && electron dist/test/workflow-smoke.cjs",
    "check": "npm run build:test && node --test dist/test/*.test.cjs && electron dist/test/desktop-smoke.cjs && electron dist/test/workflow-smoke.cjs",
    "setup:local": "node --experimental-strip-types scripts/local-opik.mts start",
    "opik:start": "node --experimental-strip-types scripts/local-opik.mts start",
    "opik:status": "node --experimental-strip-types scripts/local-opik.mts status",
    "opik:stop": "node --experimental-strip-types scripts/local-opik.mts stop",
    "build:test": "npm run build && node dist/scripts/assets.mjs --tests-only"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "electron": "^44.0.0",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@lmstudio/sdk": "2.1.0",
    "opik": "2.2.144",
    "zod": "4.6.6"
  }
}
